GMAIL_USER=your-email@yourdomain.com
GMAIL_PASSWORD=your-app-password-here
GMAIL_SMTP=smtp.gmail.com
# Comma-separated Gemini keys for the AI email-guess step (also accepts GEMINI_API_KEY=single)
GEMINI_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Set to 0 to disable the Gemini email-guess step
GEMINI_EMAIL_GUESS=1
HUNTER_API_KEY=your-hunter-api-key
